# Django Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=False

# Allowed hosts (add your server IP/domain)
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip

# Database (SQLite - default, no PostgreSQL needed)
# No database URL needed - uses SQLite by default

# Optional: Custom port for runserver
# PORT=8000